when*.\n\n```json\n{\n  \"task_id\": \"t_798d04c6\",\n  \"decision\": \"present\",\n  \"mechanism\": \"regime_switch\",\n  \"entities\": [121, 357, 381, 594, 728, 785, 898, 1269, 1415, 1460, 1701, 1923],\n  \"window\": [64269, 94269],\n  \"confidence\": 0.9,\n  \"evidence\": [\n    {\"trace_id\": \"step_02\", \"role\": \"confounder_control\"},\n    {\"trace_id\": \"step_04\", \"role\": \"confounder_control\"},\n    {\"trace_id\": \"step_05\", \"role\": \"confounder_control\"},\n    {\"trace_id\": \"step_06\", \"role\": \"support\"},\n    {\"trace_id\": \"step_07\", \"role\": \"support\"},\n    {\"trace_id\": \"step_08\", \"role\": \"support\"},\n    {\"trace_id\": \"step_09\", \"role\": \"support\"},\n    {\"trace_id\": \"step_10\", \"role\": \"support\"},\n    {\"trace_id\": \"step_11\", \"role\": \"support\"},\n    {\"trace_id\": \"step_12\", \"role\": \"support\"},\n    {\"trace_id\": \"step_13\", \"role\": \"support\"},\n    {\"trace_id\": \"step_14\", \"role\": \"confounder_control\"},\n    {\"trace_id\": \"step_15\", \"role\": \"confounder_control\"},\n    {\"trace_id\": \"step_16\", \"role\": \"confounder_control\"},\n    {\"trace_id\": \"step_17\", \"role\": \"confounder_control\"},\n    {\"trace_id\": \"step_18\", \"role\": \"support\"},\n    {\"trace_id\": \"step_19\", \"role\": \"support\"},\n    {\"trace_id\": \"step_20\", \"role\": \"confounder_control\"},\n    {\"trace_id\": \"step_21\", \"role\": \"confounder_control\"},\n    {\"trace_id\": \"step_22\", \"role\": \"confounder_control\"},\n    {\"trace_id\": \"step_23\", \"role\": \"confounder_control\"},\n    {\"trace_id\": \"step_24\", \"role\": \"confounder_control\"},\n    {\"trace_id\": \"step_25\", \"role\": \"confounder_control\"},\n    {\"trace_id\": \"step_28\", \"role\": \"support\"},\n    {\"trace_id\": \"step_29\", \"role\": \"support\"}\n  ],\n  \"narrative\": \"The 12-node group shows an abrupt, coordinated change of interaction partners at t~79269. Event volume and degree are flat across