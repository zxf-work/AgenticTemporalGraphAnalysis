d\",\n  \"decision\": \"insufficient\",\n  \"mechanism\": \"cascade\",\n  \"entities\": [695, 1495, 407, 153, 1541, 156, 1517, 1468],\n  \"window\": [28025, 66424],\n  \"confidence\": 0.6,\n  \"narrative\": \"A static route from 695 to 1495 exists (695->407->153->1541->1495, and 695->...->156->1517->1495), but every edge on it fires exactly once and no available tool exposes timestamps or restricts to the query window, so the ordering and the <=600-unit inter-event gaps cannot be verified. The intermediaries (407, 153, 156) are top-activity hubs with very high triangle counts, meaning static reachability is expected by hub mixing alone and cannot be taken as cascade evidence. Hence the temporal claim is unsupported rather than confirmed or refuted.\",\n  \"evidence\": [\n    {\"trace_id\": \"step_02\", \"role\": \"support\"},\n    {\"trace_id\": \"step_03\", \"role\": \"support\"},\n    {\"trace_id\": \"step_04\", \"role\": \"support\"},\n    {\"trace_id\": \"step_10\", \"role\": \"support\"},\n    {\"trace_id\": \"step_11\", \"role\": \"support\"},\n    {\"trace_id\": \"step_15\", \"role\": \"support\"},\n    {\"trace_id\": \"step_16\", \"role\": \"support\"},\n    {\"trace_id\": \"step_17\", \"role\": \"support\"},\n    {\"trace_id\": \"step_19\", \"role\": \"support\"},\n    {\"trace_id\": \"step_14\", \"role\": \"confounder_control\"},\n    {\"trace_id\": \"step_20\", \"role\": \"confounder_control\"},\n    {\"trace_id\": \"step_21\", \"role\": \"confounder_control\"},\n    {\"trace_id\": \"step_01\", \"role\": \"confounder_control\"}\n  ]\n}\n```", "total_input_tokens": 42295, "total_output_tokens": 8623, "total_tokens": 50918, "total_latency_ms": 121842, "llm_calls": 8, "schema_repairs": 0, "status": "success", "error": ""}