lt_summary": "{\"connected\": false, \"n_events_u_to_v\": 0, \"n_events_v_to_u\": 0, \"u\": 960, \"v\": 254, \"window\": [47196, 52295]}", "latency_ms": 0, "tokens_before": 39409, "tokens_after": 39409, "ok": true, "error": ""}], "final_claim": {"task_id": "t_b0956d24", "decision": "absent", "mechanism": "cascade", "entities": [303, 1409, 960, 254, 1574, 1293], "window": [42696, 52295], "confidence": 0.76, "narrative": "Statically, 303 and 1293 are connected in this window only through the chain 303->1409->960->254->1574->1293 (step_05, step_07); 303 has a single event (to 1409) and 1293 has three partners (726, 1438, 1574), none of which touch the 303 side directly. Temporally the chain breaks at node 960. Binning shows 303's only event and 1409's first event both fall in [46896,47495] (step_08, step_09), and 1409's second event falls in [47496,48095]. Node 960 has exactly two events: one in [46896,47195] and one in [47496,47795] (step_10). Edge 1409-960 does not occur anywhere in [42696,47195] (step_14), so the 1409->960 contact is the later one (>=47496); edge 960-254 does not occur anywhere in [47196,52295] (step_16), so the 960->254 contact is the earlier one (<=47195). Hence 960 passes information to 254 BEFORE it is ever contacted by 1409, and it has no further events afterwards. The downstream links 254-1574 and 1574-1293 do occur in [47496,48095] (step_11, step_12, step_13), so the pieces exist, but the required ordering at 960 is inverted. Static reachability and moderate window volume (1616 events, step_01) are therefore confounders rather than evidence: no delta<=600 time-respecting path from 303 to 1293 exists.", "evidence": [{"trace_id": "step_01", "role": "confounder_control"}, {"trace_id": "step_05", "role": "confounder_control"}, {"trace_id": "step_07", "role": "confounder_control"}, {"trace_id": "step_02", "role": "support"}, {"trace_id": "step_03", "role": "support"}, {"trace_id": "step_04", "role": "support"}, {"trace_id": "step_08", "role": "support"}, {"trace_id": "step_09", "role": "support"}, {"trace_id": "step_10", "role": "support"}, {"trace_id": "step_11", "role": "support"}, {"trace_id": "step_12", "role": "support"}, {"trace_id": "step_13", "role": "support"}, {"trace_id": "step_14", "role": "support"}, {"trace_id": "step_16", "role": "support"}]}, "raw_final_response": "```json\n{\n  \"task_id\": \"t_b0956d24\",\n  \"decision\": \"absent\",\n  \"mechanism\": \"cascade\",\n  \"entities\": [303, 1409, 960, 254, 1574, 1293],\n  \"window\": [42696, 52295],\n  \"confidence\": 0.76,\n  \"narrative\": \"Statically, 303 and 1293 are connected in this window only through the chain 303->1409->960->254->1574->1293 (step_05, step_07); 303 has a single event (to 1409) and 1293 has three partners (726, 1438, 1574), none of which touch the 303 side directly. Temporally the chain breaks at node 960. Binning shows 303's only event and 1409's first event both fall in [46896,47495] (step_08, step_09), and 1409's second event falls in [47496,48095]. Node 960 has exactly two events: one in [46896,47195] and one in [47496,47795] (step_10). Edge 1409-960 does not occur anywhere in [42696,47195] (step_14), so the 1409->960 contact is the later one (>=47496); edge 960-254 does not occur anywhere in [47196,52295] (step_16), so the 960->254 contact is the earlier one (<=47195). Hence 960 passes information to 254 BEFORE it is ever contacted by 1409, and it has no further events afterwards. The downstream links 254-1574 and 1574-1293 do occur in [47496,48095] (step_11, step_12, step_13), so the pieces exist, but the required ordering at 960 is inverted. Static reachability and moderate window volume (1616 events, step_01) are therefore confounders rather than evidence: no delta<=600 time-respecting path from 303 to 1293 exists.\"\n  ,\n  \"evidence\": [\n    {\"trace_id\": \"step_01\", \"role\": \"confounder_control\"},\n    {\"trace_id\": \"step_05\", \"role\": \"confounder_control\"},\n    {\"trace_id\": \"step_07\", \"rol