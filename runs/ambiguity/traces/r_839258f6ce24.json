fficient\",\n  \"mechanism\": \"cascade\",\n  \"entities\": [60, 908],\n  \"window\": [30939, 69338],\n  \"confidence\": 0.7,\n  \"evidence\": [\n    {\"trace_id\": \"step_02\", \"role\": \"support\"},\n    {\"trace_id\": \"step_03\", \"role\": \"support\"},\n    {\"trace_id\": \"step_06\", \"role\": \"confounder_control\"},\n    {\"trace_id\": \"step_04\", \"role\": \"confounder_control\"},\n    {\"trace_id\": \"step_05\", \"role\": \"confounder_control\"}\n  ],\n  \"narrative\": \"Aggregate temporal summaries show both node 60 (step_02) and node 908 (step_03) are active in the interval, but their per-600-unit binned activity does not provide a clear, ordered chain of events linking 60 to 908. There is no direct interaction between 60 and 908 in the window (step_06). A static k-hop subgraph indicates possible structural pathways (step_04) and 908 has many neighbors (step_05), so static connectivity or node popularity could suggest a route, but the available temporal aggregates are too coarse to verify a time-respecting sequence with \u2264600 gaps. Therefore the evidence is insufficient to conclude a genuine time-respecting cascade.\"\n}", "total_input_tokens": 34532, "total_output_tokens": 7450, "total_tokens": 41982, "total_latency_ms": 139815, "llm_calls": 7, "schema_repairs": 0, "status": "success", "error": ""}